+#ifdef SDL_PLATFORM_WINRT
+    /* Bandit does not enter through SDL_main: its UWP IFrameworkView already
+       exists and launches the JVM directly. SDL's normal WinRT bootstrap
+       therefore never gets a chance to call SDL_SetMainReady(). Prime the
+       flag lazily on the first SDL subsystem request before enforcing the
+       normal SDL_main readiness check. */
+    if (!SDL_MainIsReady) {
